# Copy to .env.local and fill in. Never commit real values.

# Base URL of the Vesrace REST API (/api/v1). Safe to expose to the browser.
# Leave empty while the frontend runs on mock data.
NEXT_PUBLIC_API_BASE_URL=

# Server-only secrets (payment keys, session secrets, database URLs) must NOT
# use the NEXT_PUBLIC_ prefix and are not needed in phase 1.
